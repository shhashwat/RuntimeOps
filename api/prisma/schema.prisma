generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  DEVELOPER
  VIEWER
}

enum Environment {
  PRODUCTION
  STAGING
  PREVIEW
}

enum DeploymentStrategy {
  MANUAL
  QUEUED
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  DEPLOYING
  HEALTH_CHECK
  SUCCESS
  FAILED
}

enum LogLevel {
  INFO
  WARNING
  ERROR
}

enum ActivityType {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  DEPLOYMENT_TRIGGERED
  DEPLOYMENT_STATUS_CHANGED
  DEPLOYMENT_FAILED
  DEPLOYMENT_SUCCEEDED
  USER_LOGIN
  USER_REGISTER
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  email         String         @unique
  passwordHash  String         @map("password_hash")
  role          Role           @default(DEVELOPER)

  projects      Project[]
  deployments   Deployment[]
  refreshTokens RefreshToken[]
  activities    Activity[]

  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("users")
}

model Project {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  slug                String               @unique
  repoUrl             String               @map("repo_url")
  environment         Environment
  deploymentStrategy  DeploymentStrategy   @default(QUEUED) @map("deployment_strategy")

  createdById         String               @map("created_by") @db.Uuid
  createdBy           User                 @relation(fields: [createdById], references: [id])

  deployments         Deployment[]
  activities          Activity[]

  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@map("projects")
}

model Deployment {
  id                 String              @id @default(uuid()) @db.Uuid

  projectId          String              @map("project_id") @db.Uuid
  project            Project             @relation(fields: [projectId], references: [id])

  triggeredById      String              @map("triggered_by") @db.Uuid
  triggeredBy        User                @relation(fields: [triggeredById], references: [id])

  status             DeploymentStatus

  targetEnvironment  String              @map("target_environment")

  retryCount         Int                 @default(0) @map("retry_count")

  logs               DeploymentLog[]
  activities         Activity[]

  startedAt          DateTime?           @map("started_at")
  completedAt        DateTime?           @map("completed_at")

  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([status])

  @@map("deployments")
}

model DeploymentLog {
  id              String          @id @default(uuid()) @db.Uuid

  deploymentId    String          @map("deployment_id") @db.Uuid
  deployment      Deployment      @relation(fields: [deploymentId], references: [id])

  level           LogLevel
  message         String

  sequence        Int

  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([deploymentId])

  @@map("deployment_logs")
}

model RefreshToken {
  id            String        @id @default(uuid()) @db.Uuid

  userId        String        @map("user_id") @db.Uuid
  user          User          @relation(fields: [userId], references: [id])

  tokenHash     String        @map("token_hash")

  expiresAt     DateTime      @map("expires_at")

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([userId])

  @@map("refresh_tokens")
}

model Activity {
  id              String          @id @default(uuid()) @db.Uuid

  type            ActivityType
  message         String

  userId          String          @map("user_id") @db.Uuid
  user            User            @relation(fields: [userId], references: [id])

  projectId       String?         @map("project_id") @db.Uuid
  project         Project?        @relation(fields: [projectId], references: [id])

  deploymentId    String?         @map("deployment_id") @db.Uuid
  deployment      Deployment?     @relation(fields: [deploymentId], references: [id])

  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([createdAt])

  @@map("activities")
}
